# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pakistan_ecommerce
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change_me_secure_password

# Connection string (optional override)
# DATABASE_URL=postgresql://analytics:change_me_secure_password@localhost:5432/pakistan_ecommerce

# dbt
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev

# Airflow
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Data generation (defaults match portfolio scale)
NUM_CUSTOMERS=100000
NUM_PRODUCTS=5000
NUM_SELLERS=1000
NUM_ORDERS=300000
NUM_RETURNS=30000
DATA_START_DATE=2023-01-01
DATA_END_DATE=2025-12-31
RANDOM_SEED=42

# Pipeline
BATCH_SIZE=10000
LOG_LEVEL=INFO
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
EXPORTS_DIR=./data/exports
LOGS_DIR=./logs
