pakistan_ecommerce:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | as_number }}"
      user: "{{ env_var('POSTGRES_USER', 'analytics') }}"
      password: "{{ env_var('POSTGRES_PASSWORD', 'change_me_secure_password') }}"
      dbname: "{{ env_var('POSTGRES_DB', 'pakistan_ecommerce') }}"
      schema: analytics
      threads: 4
